# Sourced by scripts/run_trainval.sh. Environment overrides take precedence.
# Explicit trainval profile; historical mini entry points keep their defaults.
CONDA_ROOT="${CONDA_ROOT:-${HOME}/miniconda3}"
CONDA_ENV="${CONDA_ENV:-bev}"
NUSCENES_ROOT="${NUSCENES_ROOT:-${HOME}/datasets/nuscenes}"
BEVCAR_SOURCE_DIR="${BEVCAR_SOURCE_DIR:-${REPO_ROOT}/external/BEVCar}"
TORCH_HOME="${TORCH_HOME:-${REPO_ROOT}/.cache/torch}"
MPLCONFIGDIR="${MPLCONFIGDIR:-${REPO_ROOT}/.cache/matplotlib}"
DSET=trainval
NSWEEPS="${NSWEEPS:-5}"
NUM_WORKERS=0
# Existing held-out scripts cache samples on GPU. Keep them bounded.
TRAIN_SAMPLES="${TRAIN_SAMPLES:-64}"
VAL_SAMPLES="${VAL_SAMPLES:-16}"
STEPS="${STEPS:-512}"
SEED_LIST="${SEED_LIST:-125,42,7}"
SAMPLE_SELECTION="${SAMPLE_SELECTION:-uniform}"
TAG="${TAG:-trainval_train${TRAIN_SAMPLES}_val${VAL_SAMPLES}_nsweeps${NSWEEPS}_${SAMPLE_SELECTION}}"
OUTPUT_DIR="${OUTPUT_DIR:-${REPO_ROOT}/artifacts/trainval}"
# Separate supervised streaming baseline, not self-supervised BEVCar training.
BATCH_SIZE=1
GRAD_ACC=1
RES_SCALE="${RES_SCALE:-1}"
MAX_ITERS="${MAX_ITERS:-30000}"
SAVE_FREQ="${SAVE_FREQ:-1000}"
USE_SCHEDULER="${USE_SCHEDULER:-True}"
EXP_NAME="${EXP_NAME:-trainval_metaradar}"
LOG_DIR="${LOG_DIR:-${REPO_ROOT}/logs_trainval}"
CKPT_DIR="${CKPT_DIR:-${REPO_ROOT}/checkpoints/trainval}"
